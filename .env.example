# Copy to .env and fill in. .env is gitignored.

# Agent model (Phase 2). Ollama speaks the OpenAI API, so the same client works for both.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=rewardlab-qwen3-4b   # built from backend/ollama/Modelfile (qwen3:4b-instruct, 8k context)
OPENAI_API_KEY=        # only needed for an OpenAI reference model
MOONSHOT_API_KEY=
HF_TOKEN=              # Phase 7: downloading Qwen/Qwen3-4B-Instruct-2507 weights for training

# Optional tracing. Leave the keys empty to disable.
# Cloud (cloud.langfuse.com) sends prompts and responses to Langfuse's servers;
# self-host with Docker to keep everything local (map it off port 3000; the web UI uses that).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
